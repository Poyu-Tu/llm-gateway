# M0.5 觀察 4 A 段：把 gpt-6-luna 加進 LiteLLM，不填單價（2026-09-26 17:11，第二台電腦）
# 管理金鑰從 .env 讀進變數 $mk，未出現在指令列
# api_key 填的是環境變數參照 "os.environ/OPENAI_API_KEY"，不是金鑰本體

PS C:\Users\<user>\llm-gateway\scripts\litellm-lab> $mk = (gc .env) -match '^LITELLM_MASTER_KEY=' -replace '^LITELLM_MASTER_KEY=',''
PS C:\Users\<user>\llm-gateway\scripts\litellm-lab> $mk = $mk[0]
PS C:\Users\<user>\llm-gateway\scripts\litellm-lab> $mh = @{Authorization="Bearer $mk"}
PS C:\Users\<user>\llm-gateway\scripts\litellm-lab> $m = '{"model_name":"gpt-6-luna","litellm_params":{"model":"openai/gpt-6-luna","api_key":"os.environ/OPENAI_API_KEY"}}'
PS C:\Users\<user>\llm-gateway\scripts\litellm-lab> irm http://127.0.0.1:4000/model/new -Method Post -Headers $mh -ContentType application/json -Body $m


