# M0.5 觀察 4 A 段：用內建價格表沒有的 gpt-6-luna 透過 LiteLLM 呼叫（2026-09-26 17:29，第二台電腦）
# 虛擬金鑰：max_budget 0.01、只允許 gpt-6-luna；金鑰只存在變數 $k，未印出

PS C:\Users\<user>\llm-gateway\scripts\litellm-lab> $k = irm http://127.0.0.1:4000/key/generate -Method Post -Headers $mh -ContentType application/json -Body '{"max_budget":0.01,"models":["gpt-6-luna"]}'
PS C:\Users\<user>\llm-gateway\scripts\litellm-lab> $vh = @{Authorization="Bearer $($k.key)"}
PS C:\Users\<user>\llm-gateway\scripts\litellm-lab> $b = '{"model":"gpt-6-luna","reasoning_effort":"none","max_completion_tokens":50,"messages":[{"role":"user","content":"Say hi in 5 words."}]}'
PS C:\Users\<user>\llm-gateway\scripts\litellm-lab> $w = iwr http://127.0.0.1:4000/v1/chat/completions -Method Post -Headers $vh -ContentType application/json -Body $b -UseBasicParsing
PS C:\Users\<user>\llm-gateway\scripts\litellm-lab> (Get-Date).ToString('HH:mm:ss')

17:29:53
PS C:\Users\<user>\llm-gateway\scripts\litellm-lab> $w.Headers['x-litellm-response-cost']
