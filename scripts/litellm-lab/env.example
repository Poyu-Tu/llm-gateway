# 複製成 .env 後填入亂數；.env 不進版控（見 .gitignore）
# 只用英數字：密碼會組進 postgresql://帳號:密碼@db:5432/... 網址，特殊字元會把網址切錯
# Windows PowerShell 產生方式：[guid]::NewGuid().ToString("N")
# 三組都要寫進檔案時，不要打開檔案貼上，改用下面這兩行直接寫檔（全程不顯示在畫面上，寫出無 BOM 的 UTF-8）：
#   $g = { [guid]::NewGuid().ToString("N") }
#   [IO.File]::WriteAllText("$PWD\.env", "LITELLM_MASTER_KEY=sk-$(& $g)`r`nLITELLM_SALT_KEY=$(& $g)`r`nPOSTGRES_PASSWORD=$(& $g)")
# 驗證只看行數與長度，不打開檔案：(gc .env).Count; (gi .env).Length
LITELLM_MASTER_KEY=sk-換成32字亂數
# 注意：SALT_KEY 用來加密資料庫裡的模型設定，換掉後舊資料全部解不開；要換就連資料庫一起清（docker compose down -v）
LITELLM_SALT_KEY=換成32字亂數
POSTGRES_PASSWORD=換成32字亂數

# OpenAI API Key：只在需要實際呼叫模型的實驗才填，平常留空（留空時 docker compose 會出現 not set 警告，屬正常）
# 規格：OpenAI 專用 Project 的服務帳號金鑰、權限 Restricted 只開 Chat completions、有效期限 30 天
# 實驗結束：到 OpenAI 後台撤銷金鑰，並把這裡清回空白
OPENAI_API_KEY=
