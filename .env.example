# Copy this file to .env and fill in real values. Never commit .env.
# 複製成 .env 後填入真值；.env 絕對不能進 Git

# OpenAI service-account key (Restricted: Chat completions only, 30-day expiry)
OPENAI_API_KEY=

# HMAC key for audit hashes. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HMAC_KEY=

# Where DynamoDB is: a URL for DynamoDB Local (compose.yaml), or "aws" for the real one with the IAM role
# DynamoDB 在哪裡：練習場寫網址；寫 aws 就連雲端（身分用 IAM 角色）
DYNAMODB_TARGET=http://127.0.0.1:8001