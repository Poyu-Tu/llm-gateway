# Copy this file to .env and fill in real values. Never commit .env.
# 複製成 .env 後填入真值；.env 絕對不能進 Git

# OpenAI service-account key (Restricted: Chat completions only, 30-day expiry)
OPENAI_API_KEY=

# HMAC key for audit hashes. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HMAC_KEY=

# DynamoDB endpoint. Local development uses DynamoDB Local
from compose.yaml
DYNAMODB_ENDPOINT_URL=http://127.0.0.1:8001